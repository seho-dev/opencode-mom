{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent"],
  "agent": {
    "creative-ui-coder": {
      "model": "cliproxyapi/gemini-3.1-pro-high",
      "description": "UI implementation fixture agent.",
      "mode": "subagent",
      "prompt": "{file:./prompts/creative-ui-coder.md}"
    },
    "Jenny": {
      "model": "cliproxyapi/minimax-m2.7",
      "description": "Specification fixture agent.",
      "mode": "subagent"
    },
    "karen": {
      "model": "cliproxyapi/minimax-m2.7",
      "description": "Completion fixture agent.",
      "mode": "subagent"
    }
  },
  "provider": {
    "cliproxyapi": {
      "name": "CLIProxyAPI",
      "options": {
        "baseURL": "https://example.invalid/v1",
        "apiKey": "SANITIZED_API_KEY_PLACEHOLDER"
      }
    }
  }
}
