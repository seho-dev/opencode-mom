{
  "name": "opencode-mom",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "preview": "vite preview",
    "test:components": "vitest run",
    "test:unit": "node --test --test-concurrency=1 src/config/__tests__/*.test.mjs src/routes/*/__tests__/*.test.mjs src/utils/__tests__/*.test.mjs",
    "prepare": "husky",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "1.24.0",
    "@tanstack/svelte-form": "^1.33.5",
    "@tauri-apps/api": "^2.10.2",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@internationalized/date": "3.12.2",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.43.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.2",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.10.2",
    "@testing-library/svelte": "^5.4.2",
    "bits-ui": "2.18.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "svelte": "^5.45.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,svelte,css,json,jsonc,html}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
