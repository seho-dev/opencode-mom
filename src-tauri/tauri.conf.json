{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opencode-mom",
  "version": "2.0.2",
  "identifier": "dev.seho.opencode-mom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "opencode-mom",
        "url": "/",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "capabilities": [
        "tray-events",
        "island-events",
        {
          "identifier": "main-macos-drag",
          "description": "Native titlebar dragging for the main macOS window.",
          "local": true,
          "windows": ["main"],
          "platforms": ["macOS"],
          "permissions": ["core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize"]
        }
      ],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
